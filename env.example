# InsForge
NEXT_PUBLIC_INSFORGE_URL=https://your-appkey.us-east.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
# Service key — solo para operaciones de administrador (cambio de contraseña sin OTP, etc.)
INSFORGE_SERVICE_KEY=

# App URL (used to build absolute webhook/callback URLs)
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ─── Payment provider ──────────────────────────────────────────
# Redsys (Santander TPV) is the only gateway. The dashboard reads this to
# report whether payments are wired up.
PAYMENT_PROVIDER=redsys

# ─── Redsys ────────────────────────────────────────────────────
# Credentials provided by your bank or Redsys directly
REDSYS_MERCHANT_CODE=999008881
REDSYS_TERMINAL=1
# SHA-256 key from the Redsys admin panel
REDSYS_SECRET_KEY=sq7HjrUOBfKmC576ILgskD5srU870gJ7
# "test" or "live"
REDSYS_ENVIRONMENT=test

# Notification URL to configure in Redsys (DS_MERCHANT_MERCHANTURL):
#   https://yourdomain.com/api/webhooks/redsys

# Shared secret for the scheduled jobs (booking reminders). Any long random
# string; the scheduler sends it as `Authorization: Bearer <value>`.
CRON_SECRET=
